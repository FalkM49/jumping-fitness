<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Локальные эмуляторы Firebase (HTTP) — только в debug-сборке. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- В debug Firebase создаёт только Dart (firebase_bootstrap.dart):
             иначе Android заранее поднимает приложение настоящего проекта
             из google-services.json, и режим эмуляторов (проект demo-…)
             падает с duplicate-app. Настоящий проект Dart поднимает сам
             из firebase_options.dart. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>
