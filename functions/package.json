{
  "name": "jumping-fitness-functions",
  "private": true,
  "description": "Cloud Functions Jumping Fitness: вся строгая бизнес-логика (ТЗ, раздел 8)",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:netlify": "tsc && node scripts/bundle-netlify.mjs",
    "emulators": "npm run build && node scripts/firebase-emulators.mjs emulators:start --config ../firebase.json --only auth,firestore,functions --project demo-jumping-fitness --import ../firebase/dev/emulator-data --export-on-exit ../firebase/dev/emulator-data",
    "dev:links": "node scripts/email-links.mjs",
    "dev:make-admin": "node scripts/make-admin.mjs",
    "dev:trainer-request": "node scripts/trainer-request.mjs",
    "dev:seed": "node scripts/seed.mjs",
    "seed": "node scripts/seed.mjs",
    "deploy:yc": "node scripts/deploy-yandex.mjs",
    "deploy:rules": "npx firebase deploy --config ../firebase.json --only firestore:rules,firestore:indexes",
    "dev:api": "npm run build && node scripts/yandex-local.mjs",
    "dev:api:netlify": "npm run build:netlify && node scripts/netlify-local.mjs",
    "dev:client": "node scripts/client.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.9.3"
  }
}
